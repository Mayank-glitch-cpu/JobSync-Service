{
  "name": "jobsync-mcp",
  "author": "mayank-glitch-cpu",
  "license": "MIT",
  "version": "0.3.0",
  "description": "Agentic MCP server for aggregating jobs into Airtable via any MCP client",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jobsync-mcp": "bin/jobsync-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "airtable": "^0.12.2",
    "cheerio": "^1.0.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
