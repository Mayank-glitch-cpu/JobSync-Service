# Google Sheets CSV export URL
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/1W6jVjtZ1T3rtIbcw9HWJcdm2vAXjoKD08y8qeZNgk_Q/export?format=csv&gid=550557022

# Claude AI
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Airtable
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Jobs

# RapidAPI (Y Combinator Jobs + JSearch + LinkedIn)
RAPIDAPI_KEY=your-rapidapi-key

# Adzuna (optional — free tier: 250 req/month, sign up at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs (optional — free, unlimited, sign up at https://developer.usajobs.gov/APIRequest/Index)
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# JSearch settings
JSEARCH_QUERY=software developer jobs in USA
JSEARCH_NUM_PAGES=1

# Storage backend (jobsync-mcp): local (SQLite + ~/.jobsync, default) or
# firestore (GCP Firestore — use for Cloud Run so state survives cold starts).
JOBSYNC_STORAGE_BACKEND=local
# Firestore options (only when JOBSYNC_STORAGE_BACKEND=firestore):
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=
JOBSYNC_RESPONSE_CACHE_TTL_HOURS=6

# Job sink (jobsync-mcp): elasticsearch (default) | airtable | markdown | both
JOBSYNC_SINK=elasticsearch
# Elasticsearch sink (mutu.dev). Embeddings use e5-base-v2 (768-dim) for semantic search.
JOBSYNC_ES_URL=https://job-hunt-elasticsearch-274835708611.us-east1.run.app
JOBSYNC_ES_INDEX=jobs_v2
JOBSYNC_ES_EMBEDDINGS=true
# JOBSYNC_ES_API_KEY=                 # only if the ES service is locked down

# Dashboard auth (Firebase Auth). The web apiKey is public (served to the SPA via
# /api/config). PROJECT_ID defaults to GOOGLE_CLOUD_PROJECT; authDomain defaults
# to <project>.firebaseapp.com.
FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_DOMAIN=

# Server
PORT=3001

# How many jobs to fetch (default when no range specified)
JOB_COUNT=10

# Ashby smart ingestion filters
ASHBY_KEYWORDS=software,robotics,manufacturing,data analyst,sde,early career
ASHBY_PUBLISHED_WITHIN_HOURS=24
ASHBY_INCLUDE_COMPENSATION=true
ASHBY_REQUEST_DELAY_MS=1000
ASHBY_EXCLUDE_KEYWORDS=senior,staff,principal,lead,director,manager

# Pipeline API key (optional — protects the /api/pipeline/run-all endpoint)
PIPELINE_API_KEY=